class Solution {
private:
    void findSub(int ind, vector<int>& ds, vector<int>& nums,
                 vector<vector<int>>& ans) {
        ans.push_back(ds);
        int n = nums.size();
        for (int i = ind; i < n; i++) {
            if (i != ind && nums[i] == nums[i - 1])
                continue;
            ds.push_back(nums[i]);
            findSub(i + 1, ds, nums, ans);
            ds.pop_back();
        }
    }

public:
    vector<vector<int>> subsetsWithDup(vector<int>& nums) {
        vector<vector<int>> ans;
        vector<int> ds;
        sort(nums.begin(), nums.end());
        findSub(0, ds, nums, ans);
        return ans;
    }
};
