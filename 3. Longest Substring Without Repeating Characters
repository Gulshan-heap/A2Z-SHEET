class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        vector<int> count(256, 0); // instead of unordered_map
        int left = 0, maxLength = 0;

        for (int right = 0; right < s.length(); right++) {
            char ch = s[right];
            count[ch]++;

            while (count[ch] > 1) {
                count[s[left]]--;
                left++;
            }

            maxLength = max(maxLength, right - left + 1);
        }
        return maxLength;
    }
};
