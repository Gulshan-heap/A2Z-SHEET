class Solution {
  public:
    double fractionalKnapsack(vector<int>& val, vector<int>& wt, int capacity) {
        int n = val.size();
        // Create vector of pairs {value/weight ratio, index}
        vector<pair<double, int>> items;
        
        for(int i = 0; i < n; i++) {
            double ratio = (double)val[i] / wt[i];
            items.push_back({ratio, i});
        }
        
        // Sort in descending order of ratio
        sort(items.begin(), items.end(), greater<>());
        double amt = 0;
        for(int i=0;i<n;i++){
            int idx = items[i].second;
            if(wt[idx]<=capacity){
                amt+=val[idx];
                capacity = capacity-wt[idx];
            }
            else{
                double precision = (double)capacity/wt[idx];
                amt+=(val[idx])*precision;
                break;
            }
        }
        return amt;
    }
};
